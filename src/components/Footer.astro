---
import LogoBadge from '@/components/LogoBadge.astro';
import { MapPin, Phone, Mail } from '@lucide/astro';

const year = new Date().getFullYear();

const discover = [
  { href: '/pgs-near-you', label: 'PGs Near You' },
  { href: '/colleges', label: 'Colleges' },
  { href: '/colleges/dtu', label: 'PGs near DTU' },
  { href: '/colleges/nsut', label: 'PGs near NSUT' },
  { href: '/localities', label: 'Localities' },
];

const owners = [
  { href: '/for-owners', label: 'List your PG' },
  { href: '/for-owners', label: 'Owner login' },
  { href: '/for-owners#verification', label: 'Verification' },
  { href: '/earn', label: 'Earn with PG Hunter' },
];
---

<footer class="border-t border-[color:var(--color-rule)] bg-[color:var(--color-surface-ink)] text-[color:var(--color-surface-ink-foreground)]">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-4">
      <div class="md:col-span-2">
        <a href="/" class="flex items-center gap-2.5" aria-label="PG Hunter home">
          <LogoBadge class="h-8 w-8" />
          <span class="font-display text-lg font-extrabold tracking-tight text-[color:var(--color-stage-text)]">
            PG<span class="text-accent-400">Hunter</span>
          </span>
        </a>

        <p class="mt-5 max-w-md text-sm leading-relaxed text-stone-300">
          Student-first accommodation discovery. Find PGs, rooms, hostels and co-living
          spaces near your college — with video walkthroughs, transparent pricing and
          no broker, no hidden charges.
        </p>

        <ul class="mt-6 flex flex-col gap-2.5 text-sm text-stone-300">
          <li class="flex items-center gap-2"><MapPin class="h-4 w-4 text-accent-400" aria-hidden="true" /> New Delhi, India</li>
          <li class="flex items-center gap-2">
            <Mail class="h-4 w-4 shrink-0 text-accent-400" aria-hidden="true" />
            <a href="mailto:rishabh@pghunter.in" class="transition-colors hover:text-white hover:underline">
              rishabh@pghunter.in
            </a>
          </li>
          <li class="flex items-center gap-2">
            <Phone class="h-4 w-4 shrink-0 text-accent-400" aria-hidden="true" />
            <a href="tel:+917678335011" class="transition-colors hover:text-white hover:underline">
              +91 76783 35011
            </a>
          </li>
        </ul>
      </div>

      <nav aria-label="Discover">
        <h2 class="text-sm font-bold text-stone-100">Discover</h2>
        <ul class="mt-4 flex flex-col gap-2.5 text-sm">
          {discover.map((item) => (
            <li>
              <a href={item.href} class="text-stone-300 transition-colors hover:text-white hover:underline">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav id="footer-owners" aria-label="For Owners">
        <h2 class="text-sm font-bold text-stone-100">For Owners</h2>
        <ul class="mt-4 flex flex-col gap-2.5 text-sm">
          {owners.map((item) => (
            <li>
              <a href={item.href} class="text-stone-300 transition-colors hover:text-white hover:underline">
                {item.label}
              </a>
            </li>
          ))}
        </ul>

        <p id="footer-owner-cta" class="mt-6 rounded-lg border border-white/10 bg-white/5 px-4 py-3.5 text-xs leading-relaxed text-stone-300">
          Own a PG? <a href="/for-owners" class="font-semibold text-accent-400 underline underline-offset-2 hover:text-accent-300">List it on PG Hunter</a> — reach verified students near your property.
        </p>
      </nav>
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-white/10 pt-6 text-xs text-stone-400 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} PG Hunter. All rights reserved.</p>
      <p class="w-fit rounded-md border border-white/10 bg-white/5 px-2.5 py-1 text-stone-300">
        Every PG here is published by its owner — no samples, no brokers.
      </p>
    </div>
  </div>
</footer>

<script>
  // Owner-acquisition column: relevant to guests and students weighing up a
  // listing, not to people who already have an account. Hide the whole column
  // (links + CTA) for anyone signed in; owners manage their PGs in the app.
  import { getSession, onAuthChange } from '@/lib/auth';
  const col = document.getElementById('footer-owners');
  if (col) {
    const render = (user: { role?: string; isAdmin?: boolean } | null) => {
      col.classList.toggle('hidden', Boolean(user));
    };
    getSession().then(render);
    onAuthChange(render);
  }
</script>