---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SearchPanel from '@/components/SearchPanel.astro';
import { ArrowRight, ShieldCheck, Video, Mic, BadgeCheck } from '@lucide/astro';
import { colleges } from '@/data/colleges';

/* Hero walkthrough: a real video slot (the design's play-first signature).
 * The walkthrough lives at `public/hero-video.mp4` and is committed to the
 * repo, so it ships with every build — the page renders it unconditionally.
 * (Detecting the file with node:fs here does not work: the Cloudflare adapter
 * prerenders pages inside a workerd sandbox where node:fs is not real, so the
 * detection always read false.) If the video load ever fails at runtime the
 * client script below falls back to the placeholder look. */
---

<BaseLayout>
  <section class="home-hero relative overflow-hidden bg-background">
    <div class="pointer-events-none absolute inset-0 home-hero-bg" aria-hidden="true"></div>
    <div class="pointer-events-none absolute inset-0 home-hero-dots" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-7xl px-4 pt-10 pb-20 sm:px-6 lg:px-8 lg:min-h-[min(82vh,50rem)] lg:pt-16 lg:pb-24">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1.08fr)_minmax(0,0.92fr)] lg:items-center lg:gap-12">
        <div class="min-w-0">
          <h1 class="font-display text-[2.75rem] font-extrabold leading-[0.95] tracking-tight text-stone-950 sm:text-6xl lg:text-[4.25rem]">
            PG tera <span class="pg-stroke">bhai</span> dilaega
          </h1>
          <p class="mt-5 max-w-xl text-base leading-relaxed text-stone-700 sm:text-lg">
            ₹0 brokerage, real walkthroughs, verified listings. Tu pehle dekh, phir decide kar.
          </p>

          <div class="mt-6 max-w-xl">
            <SearchPanel />
          </div>

          <ul class="mt-5 flex flex-wrap gap-2 text-xs font-semibold text-stone-700" aria-label="What you get">
            <li class="inline-flex items-center rounded-md border border-stone-950/10 bg-white/70 px-2.5 py-1.5">₹0 brokerage</li>
            <li class="inline-flex items-center rounded-md border border-stone-950/10 bg-white/70 px-2.5 py-1.5">No advance payment</li>
            <li class="inline-flex items-center rounded-md border border-stone-950/10 bg-white/70 px-2.5 py-1.5">Owner details after enquiry</li>
          </ul>

          <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-stone-600">
            <span class="font-semibold text-stone-800">Popular:</span>
            {colleges.slice(0, 5).map((c) => (
              <a href={`/colleges/${c.slug}`} class="font-medium text-[color:var(--color-violet)] underline decoration-stone-300 underline-offset-2 hover:decoration-[color:var(--color-violet)]">
                {c.shortName}
              </a>
            ))}
          </div>
        </div>

        <aside class="min-w-0" aria-label="Walkthrough preview">
          <!-- Signature: walkthrough shown play-first (slot: real video/poster or empty state). -->
          <div class="stage overflow-hidden rounded-2xl shadow-[var(--shadow-stage)]">
            <div class="relative aspect-[16/10] w-full" data-slot="hero-walkthrough" data-alt="PG walkthrough preview">
              <video
                id="hero-video"
                class="absolute inset-0 h-full w-full object-cover"
                src="/hero-video.mp4"
                autoplay
                loop
                muted
                playsinline
                preload="auto"
                aria-label="PG Hunter walkthrough video"
              ></video>
              <div class="absolute inset-x-0 top-0 flex items-start justify-between gap-2 p-4 sm:p-5">
                <span class="stage-chip"><ShieldCheck class="h-4 w-4 text-accent-300" aria-hidden="true" /> Real walkthrough, before you pay</span>
                <button
                  id="hero-video-sound"
                  class="stage-chip hidden cursor-pointer"
                  type="button"
                  aria-label="Unmute the walkthrough video"
                >
                  Tap for sound
                </button>
              </div>
              <div class="absolute inset-x-0 bottom-0 flex items-center justify-between gap-3 border-t border-white/10 bg-stone-950/60 px-5 py-3 text-[11px] font-medium text-stone-300 backdrop-blur-sm sm:px-6">
                <span class="font-semibold text-accent-400">₹0 brokerage</span>
                <span class="text-right text-stone-400">No advance. Details after enquiry.</span>
              </div>
            </div>
          </div>
        </aside>
      </div>

      <div class="ticker mt-10 border-y border-stone-950/10 py-2 sm:mt-12" aria-hidden="true">
        <div class="ticker-inner text-xs font-semibold text-stone-700">
          <span>₹0 brokerage.&nbsp;&nbsp;Video walkthroughs.&nbsp;&nbsp;Verified listings.&nbsp;&nbsp;No advance payment.&nbsp;&nbsp;Owner details after enquiry.&nbsp;&nbsp;₹0 brokerage.&nbsp;&nbsp;Video walkthroughs.&nbsp;&nbsp;Verified listings.&nbsp;&nbsp;No advance payment.&nbsp;&nbsp;Owner details after enquiry.&nbsp;&nbsp;</span>
          <span>₹0 brokerage.&nbsp;&nbsp;Video walkthroughs.&nbsp;&nbsp;Verified listings.&nbsp;&nbsp;No advance payment.&nbsp;&nbsp;Owner details after enquiry.&nbsp;&nbsp;₹0 brokerage.&nbsp;&nbsp;Video walkthroughs.&nbsp;&nbsp;Verified listings.&nbsp;&nbsp;No advance payment.&nbsp;&nbsp;Owner details after enquiry.&nbsp;&nbsp;</span>
        </div>
      </div>
    </div>
  </section>

  <section aria-labelledby="trust-heading" class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
    <h2 id="trust-heading" class="sr-only">Why use PG Hunter</h2>
    <ul class="grid gap-x-5 gap-y-3 sm:grid-cols-2 lg:grid-cols-4">
      <li class="flex items-start gap-3">
        <span class="mt-0.5 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-stone-100 text-stone-800"><Video class="h-4 w-4" aria-hidden="true" /></span>
        <div class="min-w-0 text-sm"><strong class="font-semibold text-stone-900">Video walkthroughs</strong><p class="mt-0.5 text-stone-600">See room, mess, building first.</p></div>
      </li>
      <li class="flex items-start gap-3">
        <span class="mt-0.5 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-stone-100 text-stone-800"><Mic class="h-4 w-4" aria-hidden="true" /></span>
        <div class="min-w-0 text-sm"><strong class="font-semibold text-stone-900">Owner interviews</strong><p class="mt-0.5 text-stone-600">Rules and food, straight up.</p></div>
      </li>
      <li class="flex items-start gap-3">
        <span class="mt-0.5 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-stone-100 text-stone-800"><BadgeCheck class="h-4 w-4" aria-hidden="true" /></span>
        <div class="min-w-0 text-sm"><strong class="font-semibold text-stone-900">Verified listings</strong><p class="mt-0.5 text-stone-600">Real verification status shown.</p></div>
      </li>
      <li class="flex items-start gap-3">
        <span class="mt-0.5 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-stone-100 text-stone-800"><ShieldCheck class="h-4 w-4" aria-hidden="true" /></span>
        <div class="min-w-0 text-sm"><strong class="font-semibold text-stone-900">Safety first</strong><p class="mt-0.5 text-stone-600">No pressure to pay early.</p></div>
      </li>
    </ul>
  </section>

  <section id="listings" aria-labelledby="listings-heading" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-32">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 id="listings-heading" class="font-display text-3xl font-extrabold tracking-tight text-stone-900 sm:text-4xl lg:text-5xl">
          PGs on PG Hunter
        </h2>
        <p class="mt-2 max-w-2xl text-sm text-stone-600 sm:text-base">
          Real listings from owners, with real verification status.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <a href="/pgs-near-you" class="btn-secondary">Filters</a>
        <a href="/pgs-near-you" class="btn-secondary">Sort</a>
      </div>
    </div>

    <div id="listings-grid" data-reveal-group class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3"></div>
    <p id="listings-loading" class="mt-6 text-sm font-medium text-stone-600" role="status">Checking what’s live…</p>

    <div id="listings-empty" class="card mt-6 hidden px-6 py-12 text-center">
      <p class="font-display text-lg font-bold text-stone-900">No PGs are listed yet</p>
      <p class="mx-auto mt-2 max-w-md text-sm text-stone-600">
        Owners are joining now. When a listing is approved, it shows up here with real photos, price, and verification status.
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a href="/for-owners" class="btn-primary px-6">List your PG</a>
        <a href="/colleges" class="btn-secondary px-6">Browse by college</a>
      </div>
    </div>

    <div class="mt-8 flex justify-center">
      <a href="/pgs-near-you" class="btn-primary px-8">Browse all PGs <ArrowRight class="h-4 w-4" aria-hidden="true" /></a>
    </div>
  </section>

  <section aria-labelledby="colleges-heading" class="border-y border-stone-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-32">
      <h2 id="colleges-heading" class="font-display text-3xl font-extrabold tracking-tight text-stone-900 sm:text-4xl lg:text-5xl">Start where you study</h2>
      <p class="mt-2 text-sm text-stone-600 sm:text-base">Pick your campus, see what’s close.</p>
      <div data-reveal-group class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {colleges.map((c, index) => (
          <a href={`/colleges/${c.slug}`} class="card card-hover flex items-center gap-3 p-4" data-hover-lift>
            <span class={`mono-tile ${['mono-tile--amber','mono-tile--green','mono-tile--sky','mono-tile--coral','mono-tile--sand'][index % 5]}`} aria-hidden="true">{c.shortName.slice(0, 2)}</span>
            <span class="min-w-0">
              <span class="block font-display text-base font-bold leading-tight text-stone-900">{c.shortName}</span>
              <span class="mt-0.5 block truncate text-sm text-stone-600">{c.locality}, {c.city}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section aria-labelledby="owners-heading" class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
    <div class="flex min-h-[16rem] flex-col items-start justify-between gap-6 rounded-xl border border-stone-800 bg-stone-900 p-6 text-white sm:p-10 lg:flex-row lg:items-center">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold text-accent-300">For property owners</p>
        <h2 id="owners-heading" class="mt-2 font-display text-3xl font-extrabold tracking-tight sm:text-4xl">Fill your empty beds, not your time.</h2>
        <p class="mt-2 text-sm leading-relaxed text-stone-300 sm:text-base">
          Get enquiries from verified students. You control price and availability.
        </p>
      </div>
      <a href="/for-owners" class="btn-primary shrink-0 px-8">For Owners <ArrowRight class="h-4 w-4" aria-hidden="true" /></a>
    </div>
  </section>


</BaseLayout>

<style>
  :where(a, button, input, select, textarea, [tabindex]):focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
  :where(button, a, [role="button"]):active { opacity: 0.96; }
  .pg-stroke {
    display: inline;
    background-image: linear-gradient(180deg, transparent 58%, var(--color-wash-end) 58%, var(--color-wash-fast) 88%, transparent 88%);
    padding: 0 0.06em 0.04em;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  .home-hero-bg {
    background-image:
      radial-gradient(ellipse 85% 65% at 18% 18%, var(--color-wash-glow), transparent 58%),
      radial-gradient(ellipse 55% 50% at 88% 12%, var(--color-sand-glow), transparent 55%),
      linear-gradient(180deg, var(--color-hero-top) 0%, var(--background) 70%);
  }
  .home-hero-dots {
    --dx: 0px;
    --dy: 0px;
    background-image: radial-gradient(circle at 1px 1px, var(--color-dots) 1.15px, transparent 0);
    background-size: 22px 22px;
    transform: translate3d(var(--dx), var(--dy), 0);
    transition: transform 180ms ease-out;
    will-change: transform;
  }
  @media (prefers-reduced-motion: reduce) {
    .home-hero-dots { transition: none; transform: none; }
  }
</style>

<script>
  import { fetchLiveListingsPage, renderLiveCards, wireLiveSaveButtons } from '@/lib/liveListings';

  const grid = document.getElementById('listings-grid');
  const empty = document.getElementById('listings-empty');
  const loading = document.getElementById('listings-loading');

  // Interactive hero dots (desktop hover); degrades gracefully without JS.
  const hero = document.querySelector<HTMLElement>('.home-hero');
  const dots = hero?.querySelector<HTMLElement>('.home-hero-dots');
  if (hero && dots && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    let raf = 0;
    hero.addEventListener('pointermove', (e) => {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        const r = hero.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        dots.style.setProperty('--dx', `${x * 10}px`);
        dots.style.setProperty('--dy', `${y * 8}px`);
        raf = 0;
      });
    }, { passive: true });
    hero.addEventListener('pointerleave', () => {
      dots.style.setProperty('--dx', '0px');
      dots.style.setProperty('--dy', '0px');
    });
  }

  // Walkthrough video: unmute chip + graceful fallback if the asset ever
  // fails to load (rare — the mp4 ships with every deploy).
  const video = document.getElementById('hero-video') as HTMLVideoElement | null;
  const soundChip = document.getElementById('hero-video-sound');
  if (video) {
    video.addEventListener('error', () => video.remove());
    video.addEventListener('volumechange', () => {
      if (soundChip) soundChip.classList.toggle('hidden', !video.muted);
    });
    if (soundChip) {
      soundChip.addEventListener('click', () => {
        video.muted = false;
        void video.play();
      });
    }
  }

  void (async () => {
    const { listings, total } = await fetchLiveListingsPage({ limit: 6 });

    if (loading) {
      if (total === 0) {
        loading.classList.add('hidden');
      } else {
        loading.textContent = `${total} live ${total === 1 ? 'PG' : 'PGs'} right now`;
      }
    }

    if (listings.length === 0) {
      empty?.classList.remove('hidden');
    } else if (grid) {
      await renderLiveCards(grid, listings);
      await wireLiveSaveButtons(grid);
    }
  })();
</script>
