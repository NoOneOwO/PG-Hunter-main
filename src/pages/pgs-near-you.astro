---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SearchPanel from '@/components/SearchPanel.astro';
import { SlidersHorizontal, ArrowUpDown, ChevronDown } from '@lucide/astro';
---

<BaseLayout
  title="PGs Near You — Find Student PGs, Rooms & Co-living | PG Hunter"
  description="Browse PGs, rooms and co-living spaces near your college. Filter by budget, room type, food and more on PG Hunter."
>
  <section class="border-b border-stone-200 bg-background">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <h1 class="font-display text-3xl font-extrabold tracking-tight text-stone-900 sm:text-4xl">PGs Near You</h1>
      <p class="mt-2 max-w-2xl text-sm text-stone-600 sm:text-base">
        Search, filter, sort. Find a PG that fits your college and budget.
      </p>
      <div class="mt-5 max-w-4xl">
        <SearchPanel />
      </div>
    </div>
  </section>

  <section aria-label="Search results" class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-10" id="explorer">
    <div class="flex flex-wrap items-center gap-x-4 gap-y-4 border-t border-stone-200 pt-6">
      <h2 id="results-heading" class="text-base font-bold text-stone-900 sm:text-lg">
        <span id="result-count">0</span> PGs found
      </h2>
      <div class="ml-auto flex flex-wrap items-center gap-2">
        <label class="field w-auto min-w-[13rem]">
          <ArrowUpDown class="h-4 w-4 shrink-0 text-stone-700" />
          <span class="sr-only">Sort</span>
          <select id="sort-select" name="sort" class="min-h-11 w-auto appearance-none bg-transparent py-2 pr-1 outline-none">
            <option value="recommended">Sort: Recommended</option>
            <option value="price-asc">Price: Low to High</option>
            <option value="price-desc">Price: High to Low</option>
          </select>
          <ChevronDown class="h-4 w-4 shrink-0 text-stone-500" aria-hidden="true" />
        </label>
      </div>
    </div>

    <div id="no-listings" class="card mt-5 hidden px-6 py-10 text-center">
      <p class="font-display text-lg font-bold text-stone-900">No PGs are listed yet</p>
      <p class="mx-auto mt-2 max-w-md text-sm text-stone-600">
        Owners are joining now. Approved listings show up here with real photos, rooms, and rents.
      </p>
      <div class="mt-5 flex flex-wrap items-center justify-center gap-3">
        <a href="/for-owners" class="btn-primary px-6">List your PG</a>
        <a href="/colleges" class="btn-secondary px-6">Browse by college</a>
      </div>
    </div>

    <p id="partial-note" class="mt-4 hidden rounded-md border border-stone-200 bg-stone-50 px-3.5 py-2 text-sm font-medium text-stone-700" role="status"></p>

    <div id="filter-bar" class="card mt-4 p-4" aria-label="Filters">
      <div class="flex flex-wrap items-center gap-2">
        <span class="inline-flex min-h-11 items-center gap-1.5 rounded-md border border-stone-300 bg-stone-50 px-3 text-sm font-semibold text-stone-800">
          <SlidersHorizontal class="h-4 w-4" />
          Filters
        </span>
        <button type="button" class="chip filter-chip is-active" data-filter="gender" data-value="">All</button>
        <button type="button" class="chip filter-chip" data-filter="gender" data-value="boys">Boys PG</button>
        <button type="button" class="chip filter-chip" data-filter="gender" data-value="girls">Girls PG</button>
        <button type="button" class="chip filter-chip" data-filter="gender" data-value="co-ed">Co-ed</button>
        <span class="hidden h-6 w-px bg-stone-200 sm:block" aria-hidden="true"></span>
        <button type="button" class="chip filter-chip" data-filter="food" data-value="yes">With food</button>
        <button type="button" class="chip filter-chip" data-filter="verified" data-value="verified">Verified only</button>
        <span class="hidden h-6 w-px bg-stone-200 sm:block" aria-hidden="true"></span>
        <button type="button" id="clear-filters-btn" class="chip text-red-700 hover:border-red-200 hover:bg-red-50">Clear all</button>
      </div>
      <div class="mt-3 flex flex-wrap items-center gap-2 border-t border-stone-200 pt-3">
        <span class="pr-1 text-sm font-semibold text-stone-700">Budget</span>
        <button type="button" class="chip filter-chip is-active" data-filter="budget" data-value="">Any</button>
        <button type="button" class="chip filter-chip" data-filter="budget" data-value="under-10">Under ₹10k</button>
        <button type="button" class="chip filter-chip" data-filter="budget" data-value="10-15">₹10k to ₹15k</button>
        <button type="button" class="chip filter-chip" data-filter="budget" data-value="15-20">₹15k to ₹20k</button>
        <button type="button" class="chip filter-chip" data-filter="budget" data-value="20-plus">₹20k+</button>
      </div>
      <div class="mt-3 flex flex-wrap items-center gap-2 border-t border-stone-200 pt-3">
        <span class="pr-1 text-sm font-semibold text-stone-700">Room type</span>
        <button type="button" class="chip filter-chip is-active" data-filter="roomType" data-value="">Any</button>
        <button type="button" class="chip filter-chip" data-filter="roomType" data-value="single">Single</button>
        <button type="button" class="chip filter-chip" data-filter="roomType" data-value="double">Double</button>
        <button type="button" class="chip filter-chip" data-filter="roomType" data-value="triple">Triple</button>
        <button type="button" class="chip filter-chip" data-filter="roomType" data-value="four-plus">4+ sharing</button>
      </div>
    </div>

    <div id="results-grid" data-reveal-group class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3"></div>

    <p id="results-loading" class="mt-6 text-sm font-medium text-stone-600" role="status">Loading live listings…</p>

    <div id="empty-state" class="card mt-6 hidden px-6 py-10 text-center" role="status">
      <p class="font-display text-lg font-bold text-stone-900">No PGs match those filters</p>
      <p id="empty-query" class="mt-1 text-sm font-medium text-stone-600"></p>
      <p class="mt-2 text-sm text-stone-600">Try widening budget, searching a shorter name (e.g. DTU, Rohini), or clearing a filter.</p>
      <button type="button" id="clear-filters" class="btn-secondary mt-5">Clear all filters</button>
    </div>
  </section>
</BaseLayout>

<style>
  :where(a, button, input, select, textarea, [tabindex]):focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
  :where(button, a, [role="button"]):active { opacity: 0.96; }
</style>

<script>
  // Every card on this page comes from D1, fetched after load. The filter bar
  // narrows the loaded board in the client because the API's own vocabulary
  // does not cover the food/verified chips, and the two must agree with the
  // count shown next to the heading.
  import { fetchLiveListingsPage, liveCardHtml, wireLiveSaveButtons } from '@/lib/liveListings';

  const grid = document.getElementById('results-grid')!;
  const countEl = document.getElementById('result-count')!;
  const emptyEl = document.getElementById('empty-state')!;
  const noListingsEl = document.getElementById('no-listings')!;
  const partialNote = document.getElementById('partial-note')!;
  const loadingEl = document.getElementById('results-loading')!;
  const sortSelect = document.getElementById('sort-select') as HTMLSelectElement;
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-chip'));
  const clearBtn = document.getElementById('clear-filters') as HTMLButtonElement;
  const clearBtnTop = document.getElementById('clear-filters-btn') as HTMLButtonElement;

  /** The API caps a page at 60 rows; ask for the whole board. */
  const PAGE_SIZE = 60;

  let cards: HTMLElement[] = [];
  let boardTotal = 0;
  let loadToken = 0;

  type Filters = {
    q: string;
    budget: string;
    roomType: string;
    gender: string;
    food: string;
    verified: string;
    sort: string;
  };

  const params = new URLSearchParams(window.location.search);
  const filters: Filters = {
    q: (params.get('q') ?? '').trim().toLowerCase(),
    budget: params.get('budget') ?? '',
    roomType: params.get('roomType') ?? '',
    gender: params.get('gender') ?? '',
    food: params.get('food') ?? '',
    verified: params.get('verified') ?? '',
    sort: params.get('sort') ?? 'recommended',
  };

  sortSelect.value = filters.sort;
  chips.forEach((chip) => {
    const value = filters[chip.dataset.filter as keyof Filters] ?? '';
    chip.classList.toggle('is-active', chip.dataset.value === value);
  });

  const inBudget = (rent: number): boolean => {
    switch (filters.budget) {
      case 'under-10':
        return rent < 10000;
      case '10-15':
        return rent >= 10000 && rent <= 15000;
      case '15-20':
        return rent > 15000 && rent <= 20000;
      case '20-plus':
        return rent > 20000;
      default:
        return true;
    }
  };

  const matchesQuery = (card: HTMLElement): boolean => {
    if (!filters.q) return true;
    const hay = [
      card.dataset.name,
      card.dataset.locality,
      card.dataset.colleges,
      card.dataset.collegeNames,
    ]
      .join(' ')
      .toLowerCase();
    return hay.includes(filters.q);
  };

  /** One pass over the loaded cards: show/hide, order, then report the count. */
  const apply = () => {
    const visible: HTMLElement[] = [];
    cards.forEach((card) => {
      // A live listing with no room options yet has no known rent: show it
      // rather than dropping it out of every budget band.
      const rent = card.dataset.rent ? Number(card.dataset.rent) : NaN;
      const budgetOk = Number.isNaN(rent) ? true : inBudget(rent);
      const roomTypes = card.dataset.roomtypes ?? '';
      const foodOk = filters.food ? card.dataset.food === 'yes' : true;
      const genderOk = filters.gender ? card.dataset.gender === filters.gender : true;
      const verifiedOk = filters.verified ? card.dataset.verified !== 'listed' : true;
      const roomTypeOk = filters.roomType
        ? roomTypes.split(' ').includes(filters.roomType)
        : true;

      const show = matchesQuery(card) && budgetOk && roomTypeOk && genderOk && foodOk && verifiedOk;
      card.classList.toggle('hidden', !show);
      if (show) visible.push(card);
    });

    const rentOf = (card: HTMLElement) => Number(card.dataset.rent) || 0;
    if (filters.sort === 'price-asc') {
      visible.sort((a, b) => rentOf(a) - rentOf(b));
    } else if (filters.sort === 'price-desc') {
      visible.sort((a, b) => rentOf(b) - rentOf(a));
    }
    visible.forEach((card) => grid.appendChild(card));

    countEl.textContent = String(visible.length);

    const boardIsEmpty = boardTotal === 0;
    noListingsEl.classList.toggle('hidden', !boardIsEmpty);
    emptyEl.classList.toggle('hidden', boardIsEmpty || visible.length > 0);
    const emptyQuery = document.getElementById('empty-query');
    if (emptyQuery) {
      emptyQuery.textContent = filters.q ? `No results for "${filters.q}"` : '';
    }
  };

  const syncUrl = () => {
    const next = new URLSearchParams();
    (Object.keys(filters) as (keyof Filters)[]).forEach((k) => {
      if (filters[k]) next.set(k, filters[k]);
    });
    const qs = next.toString();
    window.history.replaceState({}, '', qs ? `?${qs}` : window.location.pathname);
  };

  /** Pull the board (narrowed by the search box) and rebuild the grid. */
  const loadListings = async () => {
    const token = ++loadToken;
    const { listings, total } = await fetchLiveListingsPage({ limit: PAGE_SIZE, q: filters.q });
    // A slower earlier request must not overwrite a newer one.
    if (token !== loadToken) return;

    // A search that comes back empty cannot say whether the board itself is
    // empty or the spelling just missed. One unfiltered probe settles it, so a
    // student is never told "nobody lists PGs here" when they only mistyped.
    if (total === 0 && filters.q) {
      const probe = await fetchLiveListingsPage({ limit: 1 });
      if (token !== loadToken) return;
      boardTotal = probe.total;
    } else {
      boardTotal = total;
    }

    grid.innerHTML = '';

    if (listings.length > 0) {
      const holder = document.createElement('div');
      holder.innerHTML = listings.map((listing) => liveCardHtml(listing)).join('');
      const fragment = document.createDocumentFragment();
      while (holder.firstElementChild) fragment.appendChild(holder.firstElementChild);
      grid.appendChild(fragment);
      await wireLiveSaveButtons(grid);
    }

    cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-property]'));

    // Never pretend a truncated board is the whole board.
    const truncated = total > listings.length;
    partialNote.classList.toggle('hidden', !truncated);
    partialNote.textContent = truncated
      ? `Showing the ${listings.length} most recent of ${total} PGs — narrow your search to see the rest.`
      : '';

    loadingEl.classList.add('hidden');
    apply();
  };

  const updateFilter = (key: keyof Filters, value: string) => {
    filters[key] = value;
    syncUrl();
    apply();
  };

  sortSelect.addEventListener('change', () => updateFilter('sort', sortSelect.value));

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const key = chip.dataset.filter as keyof Filters;
      const value = chip.dataset.value ?? '';
      const isActive = chip.classList.contains('is-active');
      chips
        .filter((c) => c.dataset.filter === key)
        .forEach((c) => c.classList.toggle('is-active', c === chip && !isActive));
      updateFilter(key, isActive ? '' : value);
    });
  });

  const clearAll = () => {
    (Object.keys(filters) as (keyof Filters)[]).forEach((k) => (filters[k] = ''));
    filters.sort = 'recommended';
    sortSelect.value = 'recommended';
    chips.forEach((c) => c.classList.toggle('is-active', c.dataset.value === ''));
    syncUrl();
    // Clearing the search box has to re-ask the API — the query never left the
    // server, so there is nothing local to restore.
    void loadListings();
  };

  clearBtn.addEventListener('click', clearAll);
  clearBtnTop.addEventListener('click', clearAll);

  void loadListings();
</script>
