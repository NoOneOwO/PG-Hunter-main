---
export const prerender = false;

import BaseLayout from '@/layouts/BaseLayout.astro';
import { ArrowRight, Phone, Check } from '@lucide/astro';
import { getPlans } from '@/lib/server/plans';
import { formatINR } from '@/lib/format';

const plans = await getPlans();
---

<BaseLayout
  title="For Owners — List Your PG & Get Student Leads | PG Hunter"
  description="List your PG, rooms or co-living space on PG Hunter. Receive enquiries from students near your property. No broker, no hidden charges."
>
  <section class="border-b border-stone-200 bg-background">
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
      <div class="max-w-3xl">
        <h1 class="font-display text-3xl font-extrabold tracking-tight text-stone-900 sm:text-5xl">
          Fill your empty beds, not your time.
        </h1>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-stone-700 sm:text-lg">
          List your PG on PG Hunter for student enquiries near your property.
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a href="/login?role=owner&next=/owner/plans" class="btn-primary px-8">List your PG</a>
          <a href="mailto:rishabh@pghunter.in" class="btn-secondary px-8">
            <Phone class="h-4 w-4" aria-hidden="true" /> Talk to us
          </a>
        </div>
      </div>
    </div>
  </section>

  <section aria-labelledby="plans-heading" class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <h2 id="plans-heading" class="font-display text-2xl font-extrabold tracking-tight text-stone-900 sm:text-3xl">Plans and prices</h2>
    <p class="mt-2 max-w-2xl text-sm text-stone-600 sm:text-base">Shown exactly as configured in the app.</p>
    <div class="mt-6 grid grid-cols-1 gap-5 lg:grid-cols-2">
      {plans.map((plan) => (
        <article class="card p-6">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <h3 class="font-display text-xl font-extrabold text-stone-900">{plan.name}</h3>
              <p class="mt-1 text-sm text-stone-600">{plan.tagline}</p>
            </div>
            <p class="font-display text-2xl font-extrabold text-stone-900">
              {formatINR(plan.priceInr)}
              {plan.priceInr > 0 && <span class="text-sm font-semibold text-stone-600">/{plan.durationLabel}</span>}
              {plan.priceInr === 0 && <span class="text-sm font-semibold text-stone-600">/ {plan.durationLabel}</span>}
            </p>
          </div>
          <ul class="mt-5 space-y-2 text-sm text-stone-700">
            {plan.features.map((feature) => (
              <li class="flex items-start gap-2"><Check class="mt-0.5 h-4 w-4 shrink-0 text-stone-700" aria-hidden="true" /><span>{feature}</span></li>
            ))}
          </ul>
          {plan.checkoutNote && <p class="mt-4 rounded-md bg-stone-50 px-3 py-2 text-xs leading-relaxed text-stone-600">{plan.checkoutNote}</p>}
          {plan.hasTravelCharge && <p class="mt-2 text-xs text-stone-600">Travel charge may apply.</p>}
          <a href="/login?role=owner&next=/owner/plans" class="btn-secondary mt-5 w-full justify-center sm:w-auto">Choose {plan.name}</a>
        </article>
      ))}
    </div>
  </section>

  <section aria-labelledby="how-heading" class="border-y border-stone-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
      <h2 id="how-heading" class="font-display text-2xl font-extrabold tracking-tight text-stone-900 sm:text-3xl">How it works</h2>
      <ol class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
        <li class="card p-5"><p class="font-display text-sm font-bold text-stone-500">1</p><h3 class="mt-2 text-base font-bold text-stone-900">Create your owner account</h3><p class="mt-1 text-sm leading-relaxed text-stone-600">Sign up in a couple of minutes with your details.</p></li>
        <li class="card p-5"><p class="font-display text-sm font-bold text-stone-500">2</p><h3 class="mt-2 text-base font-bold text-stone-900">Add your property</h3><p class="mt-1 text-sm leading-relaxed text-stone-600">Rooms, rent, availability, amenities, rules, food and photos.</p></li>
        <li class="card p-5"><p class="font-display text-sm font-bold text-stone-500">3</p><h3 class="mt-2 text-base font-bold text-stone-900">Get calls from real students</h3><p class="mt-1 text-sm leading-relaxed text-stone-600">Logged-in students have your number texted to their phone. It never appears on the page, so scrapers get nothing.</p></li>
      </ol>
    </div>
  </section>

  <section aria-labelledby="verification-heading" class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <h2 id="verification-heading" class="font-display text-2xl font-extrabold tracking-tight text-stone-900 sm:text-3xl">Verification, honest by default</h2>
    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-stone-600 sm:text-base">
      Listing your property does not automatically make it "verified". Verification is earned
      through a real review process so students can trust what they see.
    </p>
    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
      <div class="card p-5"><h3 class="text-sm font-bold text-stone-900">Listed</h3><p class="mt-1 text-sm text-stone-600">Owner-submitted. Live publicly but not yet reviewed by us.</p></div>
      <div class="card p-5"><h3 class="text-sm font-bold text-stone-900">PG Hunter Verified</h3><p class="mt-1 text-sm text-stone-600">Reviewed by the PG Hunter team against our checklist.</p></div>
      <div class="card p-5"><h3 class="text-sm font-bold text-stone-900">Rishabh IRL Verified</h3><p class="mt-1 text-sm text-stone-600">Personally visited and verified by Rishabh on camera.</p></div>
    </div>
  </section>

  <section class="border-t border-stone-200">
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
      <div class="flex flex-col items-start justify-between gap-6 rounded-xl border border-stone-800 bg-stone-900 p-6 text-white sm:p-8 lg:flex-row lg:items-center">
        <div>
          <h2 class="font-display text-2xl font-extrabold tracking-tight sm:text-3xl">Ready to fill your beds?</h2>
          <p class="mt-2 text-sm text-stone-300 sm:text-base">Listings are currently being set up. Drop your details and we'll reach out.</p>
        </div>
        <a href="/login?role=owner&next=/owner/plans" class="btn-primary shrink-0 px-8">Get started <ArrowRight class="h-4 w-4" aria-hidden="true" /></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  :where(a, button, input, select, textarea, [tabindex]):focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
</style>
