---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ArrowRight } from '@lucide/astro';
import { localities } from '@/data/colleges';
---

<BaseLayout
  title="Localities — Find PGs in Your Area | PG Hunter"
  description="Explore student PGs, rooms and co-living spaces in every major Delhi locality. Pick your area and find the best accommodation."
>
  <section class="border-b border-stone-200 bg-background">
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
      <h1 class="font-display text-3xl font-extrabold tracking-tight text-stone-900 sm:text-4xl">
        Explore PGs by locality
      </h1>
      <p class="mt-3 max-w-xl text-sm text-stone-600 sm:text-base">
        Pick your area and see PGs around it across {localities.length} areas.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-10">
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {localities.map((l, index) => (
        <a
          href={`/localities/${l.slug}`}
          class="card card-hover group flex items-center gap-4 p-5"
        >
          <span class={`mono-tile ${['mono-tile--amber','mono-tile--green','mono-tile--sky','mono-tile--coral','mono-tile--sand'][index % 5]} text-[1rem]`} aria-hidden="true">{l.name.slice(0, 2).toUpperCase()}</span>
          <span class="min-w-0">
            <span class="block truncate font-display text-base font-bold text-stone-900">
              {l.name}
            </span>
            <span class="mt-1 block text-sm text-stone-600">{l.city}</span>
          </span>
          <ArrowRight class="ml-auto h-5 w-5 shrink-0 text-stone-400 transition-colors group-hover:text-stone-700" aria-hidden="true" />
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  :where(a, button, input, select, textarea, [tabindex]):focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
</style>
