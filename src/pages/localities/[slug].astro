---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import { localityBySlug, localities } from '@/data/colleges';

export function getStaticPaths() {
  return localities.map((l) => ({ params: { slug: l.slug } }));
}

const { slug } = Astro.params;
const locality = localityBySlug(slug!);

if (!locality) {
  return Astro.redirect('/localities');
}

/** What to ask D1 for: a listing's `locality` is free text the owner typed. */
const searchTerms = [locality.name];
---

<BaseLayout
  title={`PGs in ${locality.name} — Student PGs, Rooms & Co-living | PG Hunter`}
  description={`Find verified PGs, rooms and co-living spaces in ${locality.name}, ${locality.city}. Compare rent, amenities and walkthroughs on PG Hunter.`}
>
  <section class="border-b border-stone-200 bg-background">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-10">
      <nav aria-label="Breadcrumb" class="text-sm">
        <ol class="flex flex-wrap items-center gap-1.5 text-stone-600">
          <li><a href="/" class="font-medium text-[color:var(--color-violet)] hover:underline">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/localities" class="font-medium text-[color:var(--color-violet)] hover:underline">Localities</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="font-semibold text-stone-900">{locality.name}</li>
        </ol>
      </nav>

      <div class="mt-5">
        <p class="text-sm font-semibold text-stone-600">{locality.city}</p>
        <h1 class="mt-2 font-display text-3xl font-extrabold tracking-tight text-stone-900 sm:text-4xl">
          PGs in {locality.name}
        </h1>
        <p class="mt-2 text-sm text-stone-600 sm:text-base">
          <span class="font-semibold text-stone-900"><span id="result-count">0</span> <span id="result-noun">PGs</span> found</span>, cheapest first.
        </p>
      </div>
    </div>
  </section>

  <section
    id="locality-page"
    aria-label="Listings"
    data-search-terms={searchTerms.join('|')}
    class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8"
  >
    <div id="locality-grid" class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3"></div>

    <p id="locality-loading" class="text-sm font-medium text-stone-600" role="status">
      Loading live listings in {locality.name}…
    </p>

    <div id="locality-empty" class="card hidden p-8 text-center sm:p-10">
      <p class="font-display text-base font-bold text-stone-900">No PGs listed in {locality.name} yet</p>
      <p class="mx-auto mt-2 max-w-md text-sm text-stone-600">
        We’re expanding area by area. Browse what’s live now, or list a PG you own in {locality.name}.
      </p>
      <div class="mt-5 flex flex-wrap items-center justify-center gap-3">
        <a href="/pgs-near-you" class="btn-primary px-6">Browse all PGs</a>
        <a href="/for-owners" class="btn-secondary px-6">List your PG</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  :where(a, button, input, select, textarea, [tabindex]):focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
</style>

<script>
  // Live board only — the page is a saved search over the same listings the
  // browse page serves, so it can never disagree with it.
  import { fetchLiveListingsFor, renderLiveCards, wireLiveSaveButtons } from '@/lib/liveListings';

  const page = document.getElementById('locality-page');
  const grid = document.getElementById('locality-grid');
  const empty = document.getElementById('locality-empty');
  const loading = document.getElementById('locality-loading');
  const count = document.getElementById('result-count');
  const noun = document.getElementById('result-noun');

  const terms = (page?.dataset.searchTerms ?? '').split('|').filter(Boolean);

  void (async () => {
    // Cheapest first: area pages are used by students comparing rent locally.
    const listings = (await fetchLiveListingsFor(terms, 60)).sort((a, b) => {
      const rentA = a.minRent ?? Number.POSITIVE_INFINITY;
      const rentB = b.minRent ?? Number.POSITIVE_INFINITY;
      return rentA - rentB;
    });
    loading?.classList.add('hidden');
    if (count) count.textContent = String(listings.length);
    if (noun) noun.textContent = listings.length === 1 ? 'PG' : 'PGs';

    if (listings.length === 0) {
      empty?.classList.remove('hidden');
      return;
    }
    if (!grid) return;
    await renderLiveCards(grid, listings);
    await wireLiveSaveButtons(grid);
  })();
</script>
