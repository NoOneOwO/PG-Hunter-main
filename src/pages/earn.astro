---
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  Camera,
  Video,
  Building2,
  Utensils,
  MapPin,
  ShieldCheck,
  Wallet,
  Check,
  ArrowRight,
  IndianRupee,
  LayoutDashboard,
} from '@lucide/astro';
---

<BaseLayout
  title="Earn with PG Hunter — Campus Creator Program"
  description="Become a PG Hunter Campus Creator. Visit PGs, create verified ground-level content and earn. Paid assignments, clear quality rules, and a simple workflow."
>
  <section class="border-b border-stone-200 bg-background">
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
      <div class="max-w-3xl">
        <h1 class="font-display text-3xl font-extrabold tracking-tight text-stone-900 sm:text-4xl">
          Become a PG Hunter Partner
        </h1>
        <p class="mt-4 max-w-2xl text-sm leading-relaxed text-stone-600 sm:text-base">
          Go to the PGs we assign you and get them on PG Hunter.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/creator/apply" class="btn-primary px-8">
            Register as a creator <ArrowRight class="h-4 w-4" aria-hidden="true" />
          </a>
          <a href="/creator" class="btn-secondary px-8 whitespace-nowrap">
            <LayoutDashboard class="h-4 w-4" aria-hidden="true" /> Creator dashboard
          </a>
        </div>
        <p class="mt-3 text-sm text-stone-600">
          Free to apply. You are paid per assignment that passes review, and the payout is shown
          before you start.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      <div class="card p-6">
        <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-stone-100 text-stone-800"><Camera class="h-5 w-5" aria-hidden="true" /></span>
        <h2 class="mt-4 font-display text-base font-bold text-stone-900">What partners do</h2>
        <ol class="mt-3 list-decimal space-y-1.5 pl-5 text-sm leading-relaxed text-stone-700 marker:font-semibold marker:text-stone-500">
          <li>Choose PGs near you that we assign you.</li>
          <li>Make their walkthrough videos.</li>
          <li>Do minor touch-ups and take pictures.</li>
          <li>Interview the PG owner or manager.</li>
          <li>Get reviews from students already staying there.</li>
          <li>Collect information about nearby facilities.</li>
        </ol>
      </div>
      <div class="card p-6">
        <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-stone-100 text-stone-800"><Check class="h-5 w-5" aria-hidden="true" /></span>
        <h2 class="mt-4 font-display text-base font-bold text-stone-900">How you get work?</h2>
        <ol class="mt-3 list-decimal space-y-1.5 pl-5 text-sm leading-relaxed text-stone-700 marker:font-semibold marker:text-stone-500">
          <li>Apply</li>
          <li>Share your resume and previous photography/videography projects.</li>
          <li>Admin approves your application.</li>
          <li>Visit the PG and shoot.</li>
          <li>Upload everything through our platform.</li>
          <li>Admin reviews and publishes it.</li>
          <li>Get paid.</li>
        </ol>
      </div>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-2">
      <section class="card p-6">
        <h2 class="font-display text-base font-bold text-stone-900">Expectations in your work</h2>
        <ul class="mt-4 grid grid-cols-1 gap-2 text-sm text-stone-700 sm:grid-cols-2">
          <li class="flex items-center gap-2"><Building2 class="h-4 w-4 text-stone-700" aria-hidden="true" /> Room photos</li>
          <li class="flex items-center gap-2"><Camera class="h-4 w-4 text-stone-700" aria-hidden="true" /> PG exterior photos</li>
          <li class="flex items-center gap-2"><Video class="h-4 w-4 text-stone-700" aria-hidden="true" /> Room walkthrough</li>
          <li class="flex items-center gap-2"><Video class="h-4 w-4 text-stone-700" aria-hidden="true" /> Common area video</li>
          <li class="flex items-center gap-2"><MapPin class="h-4 w-4 text-stone-700" aria-hidden="true" /> Nearby-area video</li>
          <li class="flex items-center gap-2"><Utensils class="h-4 w-4 text-stone-700" aria-hidden="true" /> Mess / food review</li>
          <li class="flex items-center gap-2"><ShieldCheck class="h-4 w-4 text-stone-700" aria-hidden="true" /> Safety & environment notes</li>
          <li class="flex items-center gap-2"><Building2 class="h-4 w-4 text-stone-700" aria-hidden="true" /> Owner / student interview</li>
          <li class="flex items-center gap-2"><MapPin class="h-4 w-4 text-stone-700" aria-hidden="true" /> Transport & college connectivity</li>
          <li class="flex items-center gap-2"><Camera class="h-4 w-4 text-stone-700" aria-hidden="true" /> Nearby shops & facilities</li>
        </ul>
      </section>

      <section class="card p-6">
        <h2 class="font-display text-base font-bold text-stone-900">Quality & content rules</h2>
        <ul class="mt-4 space-y-2.5 text-sm leading-relaxed text-stone-700">
          <li>Natural light, steady shots, no heavy filters. Show the real room as students will see it.</li>
          <li>No personal data in photos (IDs, faces without consent). Get verbal consent for interviews.</li>
          <li>Honest narration only. No exaggerated claims. Safety and cleanliness observations must be factual.</li>
          <li>By uploading you grant PG Hunter permission to use, edit and publish the content per the Creator Agreement (simple consent on upload; lawyer review pending).</li>
        </ul>
      </section>
    </div>

    <section class="mt-8">
      <div class="card p-6 sm:p-8">
        <div class="grid gap-8 lg:grid-cols-[1fr_1fr]">
          <div>
            <h2 class="font-display text-base font-bold text-stone-900">How earning works</h2>
            <ul class="mt-4 space-y-3 text-sm leading-relaxed text-stone-700">
              <li class="flex gap-2.5">
                <IndianRupee class="mt-0.5 h-4 w-4 shrink-0 text-stone-700" aria-hidden="true" />
                Every assignment carries its own payout amount, agreed before you start. No per-photo guessing.
              </li>
              <li class="flex gap-2.5">
                <Check class="mt-0.5 h-4 w-4 shrink-0 text-stone-700" aria-hidden="true" />
                The payout counts once the assignment passes review, and it shows up in your dashboard immediately.
              </li>
              <li class="flex gap-2.5">
                <Wallet class="mt-0.5 h-4 w-4 shrink-0 text-stone-700" aria-hidden="true" />
                Payouts go to the UPI id on your creator profile. You can add it at any point before your first payout.
              </li>
              <li class="flex gap-2.5">
                <LayoutDashboard class="mt-0.5 h-4 w-4 shrink-0 text-stone-700" aria-hidden="true" />
                Your dashboard shows approved earnings, what is awaiting payout, and what is still in the pipeline, as separate figures.
              </li>
            </ul>
          </div>
          <div class="border-t border-stone-200 pt-6 lg:border-l lg:border-t-0 lg:pl-8 lg:pt-0">
            <h2 class="font-display text-base font-bold text-stone-900">Bring an owner, earn a referral</h2>
            <p class="mt-4 text-sm leading-relaxed text-stone-700">
              Every creator gets a share link. When a PG owner signs up through it, the referral
              is recorded on your dashboard so you can see the owners you brought on. Any bonus
              for that is added as a normal assignment, so it is always a visible line item.
            </p>
            <div class="mt-5 flex flex-wrap gap-3">
              <a href="/creator/apply" class="btn-primary px-6">
                Register as a creator <ArrowRight class="h-4 w-4" aria-hidden="true" />
              </a>
              <a href="/for-owners" class="btn-secondary px-6">See the owner side</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </section>
</BaseLayout>

<style>
  :where(a, button, input, select, textarea, [tabindex]):focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
</style>
