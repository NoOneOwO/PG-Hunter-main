---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Bookmark, ArrowRight } from '@lucide/astro';
---

<BaseLayout
  title="Saved PGs — Your Shortlist | PG Hunter"
  description="Save and compare PGs you like. Login required to build your shortlist on PG Hunter."
>
  <section class="mx-auto w-full max-w-7xl px-4 py-6 sm:px-6 lg:px-8 sm:py-8">
    <div id="saved-guest" class="mx-auto max-w-xl py-8 text-center">
      <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-xl bg-stone-100 text-stone-800">
        <Bookmark class="h-7 w-7" aria-hidden="true" />
      </span>
      <h1 class="mt-5 font-display text-2xl font-extrabold tracking-tight text-stone-900 sm:text-3xl">
        Your saved PGs
      </h1>
      <p class="mx-auto mt-2 max-w-md text-sm leading-relaxed text-stone-600">
        Save PGs you like and compare them. Log in so your shortlist follows you.
      </p>
      <a href="/login?next=/saved" class="btn-primary mt-6 px-8">
        Login to view saved PGs
        <ArrowRight class="h-4 w-4" aria-hidden="true" />
      </a>
    </div>

    <div id="saved-root" class="hidden">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <h1 class="font-display text-2xl font-extrabold tracking-tight text-stone-900 sm:text-3xl">Your saved PGs</h1>
          <p class="mt-1 text-sm text-stone-600">
            <span id="saved-count">0</span> PGs in your shortlist
          </p>
        </div>
        <a href="/pgs-near-you" class="btn-secondary">
          Browse more PGs
          <ArrowRight class="h-4 w-4" aria-hidden="true" />
        </a>
      </div>

      <div id="saved-empty" class="card mt-6 hidden p-8 text-center sm:p-10">
        <p class="font-display text-lg font-bold text-stone-900">Nothing saved yet</p>
        <p class="mt-2 text-sm text-stone-600">Tap the bookmark icon on any PG to add it to your shortlist.</p>
        <a href="/pgs-near-you" class="btn-primary mt-5">Browse PGs near you</a>
      </div>

      <div id="saved-grid" class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3"></div>
    </div>
  </section>
</BaseLayout>

<script>
  import { getSession, getSavedIds, toggleSaved } from '@/lib/auth';
  import { renderSavedGrid } from '@/lib/savedPgs';

  const guest = document.getElementById('saved-guest')!;
  const root = document.getElementById('saved-root')!;
  const grid = document.getElementById('saved-grid')!;
  const empty = document.getElementById('saved-empty')!;
  const countEl = document.getElementById('saved-count')!;

  const render = async () => {
    const ids = await getSavedIds();
    // Count what actually rendered: an id whose listing has since been
    // unpublished or expired resolves to nothing, and the page must not claim
    // a shortlist it cannot show.
    const count = await renderSavedGrid(grid, ids, { removable: true });
    countEl.textContent = String(count);
    empty.classList.toggle('hidden', count > 0);
  };

  grid.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-remove-saved]');
    if (!btn) return;
    await toggleSaved(btn.dataset.removeSaved ?? '');
    await render();
  });

  const init = async () => {
    const user = await getSession();
    if (!user) {
      // Logged out: keep the login CTA visible.
      guest.classList.remove('hidden');
      return;
    }
    guest.classList.add('hidden');
    root.classList.remove('hidden');
    await render();
  };

  void init();

  // Live updates when a card is saved/removed elsewhere (e.g. another tab).
  window.addEventListener('pghunter:saved', () => void render());
</script>
