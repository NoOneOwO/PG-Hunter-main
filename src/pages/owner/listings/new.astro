---
import OwnerLayout from '@/layouts/OwnerLayout.astro';
import ListingForm from '@/components/owner/ListingForm.astro';
import { ArrowLeft } from '@lucide/astro';
---

<OwnerLayout title="Add PG — PG Hunter" active="listings">
  <div >
    <a href="/owner/listings" class="inline-flex items-center gap-1 text-sm font-semibold text-stone-600 hover:text-[color:var(--color-violet)]">
      <ArrowLeft class="h-4 w-4" /> Back to My PGs
    </a>
    <p class="eyebrow mt-4">Owner workspace</p>
    
    <h1 class="mt-5 text-2xl font-extrabold tracking-tight text-stone-900 sm:text-3xl">Add a PG</h1>
    <p class="mt-1 text-sm font-medium text-stone-600">
      Three steps: basics, rooms &amp; amenities, then photos and contact — save a draft or submit at the end.
    </p>
  </div>
  <div class="mt-6 max-w-4xl" >
    <ListingForm mode="create" />
  </div>
</OwnerLayout>
