---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import { collegeBySlug, colleges } from '@/data/colleges';

export function getStaticPaths() {
  return colleges.map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const college = collegeBySlug(slug!);

if (!college) {
  return Astro.redirect('/colleges');
}

/**
 * What to ask D1 for. A listing almost never names the campus, so the area the
 * college sits in ("Rohini" for DTU) carries most of the matches; the short
 * name catches the owners who do spell it out.
 */
const searchTerms = [college.shortName, college.locality];
---

<BaseLayout
  title={`PGs near ${college.shortName} — Student PGs, Rooms & Co-living | PG Hunter`}
  description={`Find verified PGs, rooms and co-living spaces near ${college.name} in ${college.locality}. Compare rent, amenities and walkthroughs on PG Hunter.`}
>
  <section class="border-b border-stone-200 bg-background">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-10">
      <nav aria-label="Breadcrumb" class="text-sm">
        <ol class="flex flex-wrap items-center gap-1.5 text-stone-600">
          <li><a href="/" class="font-medium text-[color:var(--color-violet)] hover:underline">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/colleges" class="font-medium text-[color:var(--color-violet)] hover:underline">Colleges</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="font-semibold text-stone-900">{college.name}</li>
        </ol>
      </nav>

      <div class="mt-5">
        <p class="text-sm font-semibold text-stone-600">{college.locality}, {college.city}</p>
        <h1 class="mt-2 font-display text-3xl font-extrabold tracking-tight text-stone-900 sm:text-4xl">
          PGs near {college.shortName}
        </h1>
        <p class="mt-2 text-sm text-stone-600 sm:text-base">
          {college.name}. <span class="font-semibold text-stone-900"><span id="result-count">0</span> <span id="result-noun">PGs</span> found</span>
        </p>
      </div>
    </div>
  </section>

  <section
    id="college-page"
    aria-label="Listings"
    data-search-terms={searchTerms.join('|')}
    class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8"
  >
    <div id="college-grid" class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3"></div>

    <p id="college-loading" class="text-sm font-medium text-stone-600" role="status">
      Loading live listings near {college.shortName}…
    </p>

    <div id="college-empty" class="card hidden p-8 text-center sm:p-10">
      <p class="font-display text-base font-bold text-stone-900">No PGs listed near {college.shortName} yet</p>
      <p class="mx-auto mt-2 max-w-md text-sm text-stone-600">
        We’re expanding college by college. Browse what’s live now, or list a PG you own near {college.locality}.
      </p>
      <div class="mt-5 flex flex-wrap items-center justify-center gap-3">
        <a href="/pgs-near-you" class="btn-primary px-6">Browse all PGs</a>
        <a href="/for-owners" class="btn-secondary px-6">List your PG</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  :where(a, button, input, select, textarea, [tabindex]):focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
</style>

<script>
  // A college page is only a saved search over the live board — nothing is
  // prerendered, so a listing that is unpublished stops appearing here too.
  import { fetchLiveListingsFor, renderLiveCards, wireLiveSaveButtons } from '@/lib/liveListings';

  const page = document.getElementById('college-page');
  const grid = document.getElementById('college-grid');
  const empty = document.getElementById('college-empty');
  const loading = document.getElementById('college-loading');
  const count = document.getElementById('result-count');
  const noun = document.getElementById('result-noun');

  const terms = (page?.dataset.searchTerms ?? '').split('|').filter(Boolean);

  void (async () => {
    const listings = await fetchLiveListingsFor(terms);
    loading?.classList.add('hidden');
    if (count) count.textContent = String(listings.length);
    if (noun) noun.textContent = listings.length === 1 ? 'PG' : 'PGs';

    if (listings.length === 0) {
      empty?.classList.remove('hidden');
      return;
    }
    if (!grid) return;
    await renderLiveCards(grid, listings);
    await wireLiveSaveButtons(grid);
  })();
</script>
